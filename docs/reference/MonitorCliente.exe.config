<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- Cartella contenente le immagini da visualizzare -->
    <add key="ImageFolder" value="C:\immagini\"/>
    <!-- Tempo in secondi per ogni immagine -->
    <add key="ScrollingImageDelay" value="5"/>
    <!-- true: mantiene l'aspetto delle immagini; false: stretch dell'immagine -->
    <add key="KeepImageRatio" value="true"/>
    <!-- File contenente il testo scorrevole in basso -->
    <add key="ScrollingTextFile" value="testo.txt"/>
    <!-- Velocità di scorrimento del testo -->
    <add key="ScrollingTextDelay" value="15"/>
    <!-- Logo esecente in alto a sinistra -->
    <add key="ImageLogo" value="Logo.png"/>
    <!-- Colore di sfondo della barra in basso -->
    <add key="BottomBackColor" value=""/>
    <!-- Colore del testo della barra in basso (testo scorrevole) -->
    <add key="BottomForeColor" value=""/>
    <!-- Colore di sfondo della barra in alto -->
    <add key="TopBackColor" value=""/>
    <!-- Colore del testo della barra in alto -->
    <add key="TopForeColor" value=""/>
    <!-- Colore di sfondo dello scontrino -->
    <add key="ReceiptBackColor" value=""/>
    <!-- Colore del testo dello scontrino -->
    <add key="ReceiptForeColor" value=""/>
    <!-- Colore di sfondo dell'area attorno allo scontrino -->
    <add key="ReceiptBackgroundColor" value=""/>
    <!-- Colore della linea di separazione col totale -->
    <add key="ReceiptLineSeparatorColor" value=""/>
  </appSettings>
</configuration>
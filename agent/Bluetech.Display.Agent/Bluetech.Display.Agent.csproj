<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Il servizio che legge Scontrino.txt, lo toglie subito dopo la lettura e manda al display i messaggi del protocollo
    (display/src/types/protocol.ts) via WebSocket. Gira come servizio Windows; si pubblica come eseguibile unico.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Bluetech.Display.Agent</RootNamespace>
    <AssemblyName>BluetechDisplayAgent</AssemblyName>
    <Version>0.1.0</Version>
    <Company>Bluetech</Company>
    <Product>Bluetech Display Agent</Product>
    <Description>Legge lo scontrino scritto da Passepartout Menu e lo manda al monitor cliente.</Description>
    <Copyright>Bluetech</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bluetech.Display.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Server\diagnostica.html" />
    <None Remove="Server\diagnostica.html" />
    <EmbeddedResource Include="Server\diagnostica.html" LogicalName="diagnostica.html" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Il servizio che legge Scontrino.txt, lo toglie subito dopo la lettura e manda al display i messaggi del protocollo
    (display/src/types/protocol.ts) via WebSocket. Gira come servizio Windows; si pubblica come eseguibile unico.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Bluetech.Display.Agent</RootNamespace>
    <AssemblyName>BluetechDisplayAgent</AssemblyName>
    <Version>0.1.0</Version>
    <Company>Bluetech</Company>
    <Product>Bluetech Display Agent</Product>
    <Description>Legge lo scontrino scritto da Passepartout Menu e lo manda al monitor cliente.</Description>
    <Copyright>Bluetech</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bluetech.Display.Agent.Tests" />
  </ItemGroup>

  <!-- Le pagine stanno dentro l'exe: /cliente e /diagnostica, /auth, /backoffice e l'errore per chi non è autorizzato. -->
  <ItemGroup>
    <Content Remove="Server\*.html" />
    <None Remove="Server\*.html" />
    <EmbeddedResource Include="Server\diagnostica.html" LogicalName="diagnostica.html" />
    <EmbeddedResource Include="Server\auth.html" LogicalName="auth.html" />
    <EmbeddedResource Include="Server\backoffice.html" LogicalName="backoffice.html" />
    <EmbeddedResource Include="Server\negato.html" LogicalName="negato.html" />
    <!-- La PWA di /cliente: manifest, service worker, pagina di attesa, script dell'installazione, icone. -->
    <Content Remove="Server\pwa\**" />
    <None Remove="Server\pwa\**" />
    <EmbeddedResource Include="Server\pwa\*" LogicalName="pwa/%(Filename)%(Extension)" />
    <!-- Il QR della stampa di prova: porta a example.com, con la geometria di quello di Satispay. -->
    <EmbeddedResource Include="..\..\samples\qr-di-prova-geometria-satispay.txt" LogicalName="qr-prova.txt" Link="Server\qr-prova.txt" />
  </ItemGroup>

</Project>

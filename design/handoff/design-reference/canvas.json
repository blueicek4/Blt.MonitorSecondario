    "t1": { "x": 0, "y": -300, "text": "Fondamenta del sistema", "kind": "title1", "maxW": 4360 },
    "t2": { "x": 0, "y": 3780, "text": "Prototipo interattivo e confronto fra i temi", "kind": "title1", "maxW": 4280 },
    "t3": { "x": 0, "y": 5260, "text": "Gli stati a 1920×1080 — tema Bluetech, notte e giorno", "kind": "title1", "maxW": 15920 },
    "t4": { "x": 0, "y": 6740, "text": "Gli stessi stati a 1024×768 (4:3) — tema Trattoria giorno", "kind": "title1", "maxW": 6544 },
    "t5": { "x": 0, "y": 7908, "text": "Verifica dei formati intermedi", "kind": "title1", "maxW": 2726 },
    "t6": { "x": 0, "y": 9108, "text": "Verticale — totem 1080×1920", "kind": "title1", "maxW": 2240 },
    "n1": { "x": 4440, "y": 0, "text": "Il tema del locale è solo un insieme di token, in due varianti: giorno e notte. Nessun tema cambia il layout, la dimensione del totale o la posizione del footer Bluetech: cambiano colori, font, raggi e intensità degli effetti.", "w": 420, "fill": "blue" },
    "n2": { "x": 4440, "y": 4080, "text": "Apri il prototipo con il pulsante Play: i comandi a destra simulano tutto ciò che la cassa può mandare al monitor, più tema, giorno/notte, modalità del QR e intensità delle animazioni.", "w": 420, "fill": "green" },
    "n3": { "x": 16000, "y": 5560, "text": "Due modalità per il QR, scelte dal locale. 4a: a tutto schermo, il QR è l'unico protagonista. 4b: il QR prende lo spazio delle promozioni e lo scontrino si restringe da 1180 a 760 px, con il totale sempre a schermo. Su 4:3 e in verticale esiste solo la modalità a tutto schermo, perché non c'è colonna laterale.", "w": 460, "fill": "purple" },
    "n4": { "x": 6640, "y": 7040, "text": "Il 4:3 non è il 16:9 scalato: lo scontrino diventa colonna piena, lo spazio promozioni scompare e il totale passa sotto la lista.", "w": 420, "fill": "orange" }
  }
